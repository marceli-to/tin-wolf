 "objectives": [
  {
   "id": "o1",
   "text": "Take the red keycard from the security office",
   "type": "collect",
   "target": "key_red"
  },
  {
   "id": "o2",
   "text": "Destroy the guidance console in the lab",
   "type": "destroy",
   "target": "console_main"
  },
  {
   "id": "o3",
   "text": "Leave through the vehicle tunnel",
   "type": "reach",
   "target": "exit",
   "requires": [
    "o1",
    "o2"
   ]
  }
 ],
 "briefing": "Halvard Depot is a weather station high in the Ostfjell range, cut off by snow since October. Its new owners are not studying the weather: they are testing a guidance unit for long-range drones, and the prototype console sits in the depot lab.\n\nThe lab is sealed with a red keycard kept in the security office. Get the card, destroy the console, and get out through the vehicle tunnel north-east of the garage.\n\nThe front door is quickest and best guarded. A maintenance duct runs up the west side of the building into the generator room \u2014 dark, tight, and quiet."
}