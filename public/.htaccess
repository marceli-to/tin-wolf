# Tin Fox – static site (Apache). Upload with the rest of dist/.

Options -Indexes

# Always HTTPS (also behind a proxy that sets X-Forwarded-Proto).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # The game moved from / to /play/ when the landing page arrived; old deep links
  # (/?level=depot, /?players=2 …) keep working. The query string is carried over.
  RewriteCond %{QUERY_STRING} (^|&)(level|players|debug|autostart|seed|art)=
  RewriteRule ^$ /play/ [R=301,L]
</IfModule>

# Types Apache does not know by default.
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType font/ttf .ttf
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType video/mp4 .mp4
</IfModule>

# Compress text and models (GLB geometry shrinks well; PNG/JPG do not).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml font/ttf model/gltf-binary application/manifest+json
</IfModule>

# Caching: the HTML pages are always revalidated so a new build is picked up at once.
# The code bundles (main-*, play-*) have a content hash in their names and never change;
# models, the font, screenshots and videos keep their names, so they are cached for a week.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(main|play|modulepreload-polyfill)-[\w-]+\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(glb|ttf|png|svg|ico|webmanifest|webp|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
